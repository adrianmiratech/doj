# Copia este archivo a ".env" y rellena los valores reales. Nunca subas ".env" a git (ya está en .gitignore).

# Base de datos SQLite. En local, un archivo:
DATABASE_URL="file:./dev.db"
# En producción (Vercel), la URL remota de tu base en Turso (https://turso.tech), p. ej.:
# DATABASE_URL="libsql://tu-base-tuorg.turso.io"
# DATABASE_AUTH_TOKEN="el-token-que-te-da-turso"

# Clave para firmar las sesiones de Auth.js/NextAuth. Genérala con: npx auth secret
AUTH_SECRET=""

# Bot de Discord (Discord Developer Portal → tu aplicación).
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# ID del servidor de Discord. Opcional si el bot solo está en un servidor (se detecta solo).
# DISCORD_GUILD_ID=""
# Categoría donde se crean los canales de logs (#logs-empleados, #logs-actividad, ...). Tiene un valor por defecto en el código.
# DISCORD_LOG_CATEGORY_ID=""

# URL pública del portal (se usa en los mensajes que envía el bot). En local:
APP_URL="http://localhost:4173"
# En producción, la URL de tu despliegue en Vercel, p. ej.:
# APP_URL="https://doj-portal.vercel.app"

# Almacenamiento de archivos subidos (evidencias, certificados, fotos de perfil).
# En local no hace falta: se guardan en public/uploads. En Vercel es obligatorio
# (el filesystem ahí es de solo lectura): crea un Blob Store en el dashboard de
# Vercel (Storage → Create Database → Blob) y Vercel inyecta este token solo.
# BLOB_READ_WRITE_TOKEN=""
